// KS1_2_Neuro-ectoderm shared Nextflow runtime config, used by both A01 and R01.
// Numeric values are exported as env vars by the calling script (read from
// config/pipeline_config.yaml via yq) so this file is never the place numbers
// get hand-edited -- it just wires them into Nextflow's config surface, which
// plain YAML can't express (executor/process blocks).

apptainer {
    enabled    = true
    autoMounts = true
    // Shared across all analysis/ED2x_* projects on this server -- reusing it
    // avoids re-pulling multi-GB container images already cached from prior runs.
    cacheDir   = System.getenv('KS12_APPTAINER_CACHE') ?: '/storage/volume01/emile/apptainer_cache_shared'
    // Default (20m) was hit once by a slow depot.galaxyproject.org pull on
    // 2026-07-17 (bioconductor-tximeta), unrelated to any real pipeline error.
    pullTimeout = '60m'
}

executor {
    name      = 'local'
    // Global cap on simultaneously running processes of ANY kind -- the main
    // guard against NFS contention across the whole pipeline DAG.
    queueSize = (System.getenv('KS12_QUEUE_SIZE') ?: '8') as int
}

process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139, 255] ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = '-1'

    // Alignment is the single most NFS-heavy stage (reads fastqs, writes BAMs).
    // Capped independently of queueSize so it can't burst to 9-way-parallel even
    // if the global queue has room.
    withName: 'BWA_MEM' {
        maxForks = (System.getenv('KS12_ALIGN_MAX_FORKS') ?: '3') as int
        cpus     = (System.getenv('KS12_ALIGN_CPUS') ?: '20') as int
    }
    withName: 'STAR_ALIGN' {
        maxForks = (System.getenv('KS12_ALIGN_MAX_FORKS') ?: '3') as int
        cpus     = (System.getenv('KS12_ALIGN_CPUS') ?: '20') as int
    }
}
